# ==============================================================================
# BUNEC CAMEROUN — VARIABLES D'ENVIRONNEMENT ET CONFIGURATION SOUVERAINE
# ==============================================================================

# SERVEUR D'APPLICATION WEB
PORT=3000
NODE_ENV=production
APP_NAME="BUNEC Suivi d'État Civil & Publication des Bans"
APP_URL=http://localhost:3000

# BASE DE DONNÉES POSTGRESQL (PRODUCTION SOUVERAINE)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DATABASE_NAME
PGHOST=localhost
PGPORT=5432
PGDATABASE=DATABASE_NAME
PGUSER=USER
PGPASSWORD=PASSWORD

# GESTION DU CACHE REDIS & COMPRESSION EN MÉMOIRE
REDIS_URL=redis://localhost:6379

# SCELLÉS NUMÉRIQUES SOUVERAINS & HORODATAGE CERTIFIÉ (HMAC-SHA256)
BUNEC_HMAC_SECRET=replace_with_a_long_random_secret

# PASSERELLES DE NOTIFICATIONS SMS & WHATSAPP
SMS_GATEWAY_API_KEY=replace_with_sms_gateway_key
WHATSAPP_BUSINESS_TOKEN=replace_with_whatsapp_token
